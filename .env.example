# Copy to .env.local. `npm run dev` refuses any DATABASE_URL that isn't localhost.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:54329/portfolio

BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required at startup, but nothing reads it.
ENCRYPTION_KEY=local-only

# Use a separate free Cloudinary account, so test uploads stay out of production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGE_FOLDER=local
