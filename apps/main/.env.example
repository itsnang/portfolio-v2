# Copy to .env.local. `pnpm dev` refuses any DATABASE_URL that isn't localhost.
# The local database has the real roles; the Main Site connects as portfolio_public (read-only).
DATABASE_URL=postgresql://portfolio_public:portfolio_public@localhost:54329/portfolio

# Shared with the Admin Site for /api/revalidate. At least 32 characters.
REVALIDATE_SECRET=

NEXT_PUBLIC_MAIN_URL=http://localhost:3000
NEXT_PUBLIC_BLOG_URL=http://localhost:3001
