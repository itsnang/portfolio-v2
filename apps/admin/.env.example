# Copy to .env.local. `pnpm dev` refuses any DATABASE_URL that isn't localhost.
# The local database has the real roles; the Admin Site connects as portfolio_admin.
DATABASE_URL=postgresql://portfolio_admin:portfolio_admin@localhost:54329/portfolio

BETTER_AUTH_URL=http://localhost:3002
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Use a separate free Cloudinary account, so test uploads stay out of production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGE_FOLDER=local

# Same value as the Main Site's REVALIDATE_SECRET. At least 32 characters.
REVALIDATE_SECRET=
MAIN_SITE_URL=http://localhost:3000
BLOG_SITE_URL=http://localhost:3001
